# Salin menjadi .env untuk pengembangan lokal.
# Tanpa dua nilai ini aplikasi memakai penyimpanan file di folder data/.
# Untuk produksi (Vercel), isi keduanya di Project Settings -> Environment Variables.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key HANYA untuk server. Jangan pakai di browser dan jangan di-commit.
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key
